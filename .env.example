# Copier en .env puis adapter : cp .env.example .env

# Domaine public de l'application
APP_DOMAIN=belote.example.com

# Nom du routeur/service Traefik (unique sur l'hôte)
ROUTER_NAME=belote

# Réseau Docker partagé avec Traefik
TRAEFIK_NETWORK=traefik

# Entrypoint HTTPS et resolver de certificats définis dans la config Traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Authentification basique (décommenter les lignes correspondantes dans docker-compose.yml)
# Générer avec : htpasswd -nbB utilisateur motdepasse
# Garder la valeur entre apostrophes simples : les $ ne sont alors pas interprétés
BASIC_AUTH_USERS='utilisateur:$2y$05$remplacez.par.le.hash'
